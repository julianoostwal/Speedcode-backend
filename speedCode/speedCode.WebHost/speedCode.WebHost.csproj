        <UserSecretsId>speedcode-webhost-dev</UserSecretsId>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <NoWarn>$(NoWarn);1591</NoWarn>
    </PropertyGroup>
    <ItemGroup>
        <ProjectReference Include="../modules/speedCode.Core/speedCode.Core.csproj"/>
